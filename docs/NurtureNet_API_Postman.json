          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('Has tokens', () => { pm.expect(b.accessToken).to.be.a('string'); pm.expect(b.refreshToken).to.be.a('string'); });",
                  "pm.collectionVariables.set('token', b.accessToken);",
                  "pm.collectionVariables.set('refresh_token', b.refreshToken);",
                  "pm.collectionVariables.set('parent_id', b.parent.id);",
                  "console.log('\u2705 Token saved. Plan:', b.parent.subscription_plan);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\": \"+2348012345678\", \"password\": \"test1234\"}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
