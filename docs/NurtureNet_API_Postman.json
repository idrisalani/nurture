        {
          "name": "01 Register Parent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has parent_id', () => { const b=pm.response.json(); pm.collectionVariables.set('parent_id', b.parent_id); pm.expect(b.parent_id).to.be.a('string'); });",
                  "console.log('\u2705 Registered:', pm.response.json().parent_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\": \"+2348012345678\", \"full_name\": \"Mrs. Folake Adeyemi\", \"password\": \"test1234\", \"preferred_language\": \"yo\"}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
